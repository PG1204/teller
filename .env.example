# Copy to .env (gitignored). Never commit real keys.

# --- LLM provider for the discovery run (replay never needs a key); pick with --provider ---
GEMINI_API_KEY=
TELLER_GEMINI_MODEL=gemini-3.6-flash
TELLER_GEMINI_RPM=5                 # free tier pacing (requests per minute)
ANTHROPIC_API_KEY=
TELLER_ANTHROPIC_MODEL=claude-opus-5

# --- Mock target app credentials (synthetic; the model never sees them). `make mock` reads them too. ---
LEDGERLINE_USER=teller1
LEDGERLINE_PASS=Ledger!2026
LEDGERLINE_IDLE_SECONDS=600

# --- Operator identity shown in handoff records ---
TELLER_OPERATOR=operator
